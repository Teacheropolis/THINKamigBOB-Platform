{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thinkamigbob-platform-auth",
  "main": "./platform-auth-worker.mjs",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "thinkamigbob-platform-auth",
      "migrations_dir": "auth-migrations"
    }
  ],
  "vars": {
    "PRODUCTION_ENABLED": "false",
    "AUDIT_POLICY_APPROVED": "false",
    "AUDIT_PURPOSE": "authentication-and-classroom-security",
    "AUDIT_AUTHORIZED_VIEWERS": "authorized-platform-security-operators",
    "AUDIT_RETENTION_DAYS": "",
    "AUDIT_DELETION_ENFORCEMENT": "unapproved"
  }
}
