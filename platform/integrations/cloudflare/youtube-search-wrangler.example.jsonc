{
  "name": "thinkamigbob-youtube-search",
  "main": "./youtube-search-worker.mjs",
  "compatibility_date": "2026-10-10",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "REPLACE-WITH-PUBLISHED-PLATFORM.example/api/youtube/*", "zone_name": "REPLACE-WITH-PUBLISHED-PLATFORM.example" }],
  "vars": { "PLATFORM_ORIGIN": "https://REPLACE-WITH-PUBLISHED-PLATFORM.example" }
}
